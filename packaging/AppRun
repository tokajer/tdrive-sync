# AppRun entrypoint for the tdrive-sync AppImage.
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE/usr/bin:$PATH"
# Point the app at the bundled rclone binary.
export TDRIVE_RCLONE="$HERE/usr/lib/tdrive-sync/rclone"
exec "$HERE/usr/bin/tdrive-sync" "$@"
